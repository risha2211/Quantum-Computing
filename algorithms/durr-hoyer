    {
      "cell_type": "markdown",
      "source": [
        "## Durr-Hoyer Procedure\n",
        "\n",
        "The complete procedure can be summarized as follows:\n",
        "\n",
        "1. Select an initial candidate.\n",
        "2. Identify elements smaller than the candidate.\n",
        "3. Construct a quantum oracle for these elements.\n",
        "4. Apply amplitude amplification.\n",
        "5. Measure an index.\n",
        "6. Compare the corresponding value with the candidate.\n",
        "7. If the value is smaller, update the candidate.\n",
        "8. Repeat the process.\n",
        "9. The final candidate represents the minimum.\n",
        "\n",
        "Thus,\n",
        "\n",
        "$$\n",
        "\\boxed{\n",
        "\\text{Initial Candidate}\n",
        "\\rightarrow\n",
        "\\text{Quantum Search}\n",
        "\\rightarrow\n",
        "\\text{Smaller Candidate}\n",
        "\\rightarrow\n",
        "\\text{Quantum Search}\n",
        "\\rightarrow\n",
        "\\text{Minimum}\n",
        "}\n",
        "$$"
      ],
      "metadata": {
        "id": "1ZGvnQNqIWFF"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "import random\n",
        "\n",
        "from qiskit import QuantumCircuit\n",
        "from qiskit.quantum_info import Statevector"
      ],
      "metadata": {
        "id": "BmZ5dxvBIaVK"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Define the unsorted array\n",
        "array = [7, 2, 9, 4, 1, 6, 8, 3]\n",
        "\n",
        "# Number of elements\n",
        "N = len(array)\n",
        "\n",
        "# Number of qubits required to represent the indices\n",
        "n_qubits = int(np.ceil(np.log2(N)))\n",
        "\n",
        "print(\"Array:\", array)\n",
        "print(\"Number of elements:\", N)\n",
        "print(\"Number of index qubits:\", n_qubits)"
      ],
      "metadata": {
        "id": "WgzxSEO2IeaH"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "## Create the Quantum Oracle"
      ],
      "metadata": {
        "id": "ErEi2wSMIode"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def create_oracle(array, candidate):\n",
        "\n",
        "    N = len(array)\n",
        "    n = int(np.ceil(np.log2(N)))\n",
        "\n",
        "    # Identify indices whose values are smaller than the candidate\n",
        "    marked_states = [\n",
        "        i for i in range(N)\n",
        "        if array[i] < candidate\n",
        "    ]\n",
        "\n",
        "    # Start with an identity matrix\n",
        "    oracle_matrix = np.eye(2**n, dtype=complex)\n",
        "\n",
        "    # Apply a phase flip to marked states\n",
        "    for i in marked_states:\n",
        "        oracle_matrix[i, i] = -1\n",
        "\n",
        "    # Create the quantum oracle\n",
        "    oracle = QuantumCircuit(n)\n",
        "\n",
        "    oracle.unitary(\n",
        "        oracle_matrix,\n",
        "        range(n),\n",
        "        label=\"Oracle\"\n",
        "    )\n",
        "\n",
        "    return oracle, marked_states"
      ],
      "metadata": {
        "id": "RVbnPUKZIjKE"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "## Create the Diffuser\n"
      ],
      "metadata": {
        "id": "zeqL_0tQIryV"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def create_diffuser(n):\n",
        "\n",
        "    diffuser = QuantumCircuit(n)\n",
        "\n",
        "    # Create equal superposition\n",
        "    diffuser.h(range(n))\n",
        "\n",
        "    # Transform the |000...0> state\n",
        "    diffuser.x(range(n))\n",
        "\n",
        "    # Apply multi-controlled phase flip\n",
        "    diffuser.h(n - 1)\n",
        "    diffuser.mcx(list(range(n - 1)), n - 1)\n",
        "    diffuser.h(n - 1)\n",
        "\n",
        "    diffuser.x(range(n))\n",
        "    diffuser.h(range(n))\n",
        "\n",
        "    return diffuser"
      ],
      "metadata": {
        "id": "I0oqBc67Iszf"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "## Quantum Search\n"
      ],
      "metadata": {
        "id": "Pfr1xMi9IzME"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def quantum_search(array, candidate):\n",
        "\n",
        "    N = len(array)\n",
        "    n = int(np.ceil(np.log2(N)))\n",
        "\n",
        "    # Create the oracle\n",
        "    oracle, marked_states = create_oracle(array, candidate)\n",
        "\n",
        "    # If there are no smaller elements, return failure\n",
        "    if len(marked_states) == 0:\n",
        "        return None\n",
        "\n",
        "    # Create the quantum circuit\n",
        "    qc = QuantumCircuit(n)\n",
        "\n",
        "    # Put index qubits into equal superposition\n",
        "    qc.h(range(n))\n",
        "\n",
        "    # Number of marked states\n",
        "    M = len(marked_states)\n",
        "\n",
        "    # Approximate number of amplitude amplification iterations\n",
        "    iterations = max(\n",
        "        1,\n",
        "        int(np.floor((np.pi / 4) * np.sqrt(N / M)))\n",
        "    )\n",
        "\n",
        "    diffuser = create_diffuser(n)\n",
        "\n",
        "    # Apply amplitude amplification\n",
        "    for _ in range(iterations):\n",
        "        qc.compose(oracle, inplace=True)\n",
        "        qc.compose(diffuser, inplace=True)\n",
        "\n",
        "    # Obtain the final quantum state\n",
        "    state = Statevector.from_instruction(qc)\n",
        "\n",
        "    # Obtain measurement probabilities\n",
        "    probabilities = state.probabilities()\n",
        "\n",
        "    # Sample one state according to its probability\n",
        "    measured_index = np.random.choice(\n",
        "        range(2**n),\n",
        "        p=probabilities\n",
        "    )\n",
        "\n",
        "    # Ignore states outside the actual array\n",
        "    if measured_index >= N:\n",
        "        return None\n",
        "\n",
        "    return measured_index"
      ],
      "metadata": {
        "id": "lhla4y32Izv5"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "## Durr-Hoyer Minimum Finding\n"
      ],
      "metadata": {
        "id": "0vqNJ5FII3i1"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def durr_hoyer_minimum(array, repetitions=20):\n",
        "\n",
        "    N = len(array)\n",
        "\n",
        "    # Select an initial candidate randomly\n",
        "    candidate_index = random.randrange(N)\n",
        "    candidate_value = array[candidate_index]\n",
        "\n",
        "    print(\"Initial candidate:\", candidate_value)\n",
        "\n",
        "    # Repeat the quantum search\n",
        "    for iteration in range(repetitions):\n",
        "\n",
        "        # Search for an element smaller than the candidate\n",
        "        new_index = quantum_search(\n",
        "            array,\n",
        "            candidate_value\n",
        "        )\n",
        "\n",
        "        # No smaller element was found\n",
        "        if new_index is None:\n",
        "            continue\n",
        "\n",
        "        new_value = array[new_index]\n",
        "\n",
        "        # Update candidate if a smaller value is found\n",
        "        if new_value < candidate_value:\n",
        "\n",
        "            print(\n",
        "                f\"Iteration {iteration + 1}: \"\n",
        "                f\"{candidate_value} -> {new_value}\"\n",
        "            )\n",
        "\n",
        "            candidate_index = new_index\n",
        "            candidate_value = new_value\n",
        "\n",
        "    return candidate_index, candidate_value"
      ],
      "metadata": {
        "id": "MBB1JKMuI6eP"
      },
      "execution_count": null,
      "outputs": []
    },
